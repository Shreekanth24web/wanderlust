<% layout('/layouts/boilerplate') %>


    <div class="row  login-page offset-1">
        <div class="col-6 offset-3">
            
            <form action="/login" method="post" class="needs-validation login-form " novalidate>
              <h4 class="login-head">Login</h4>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input 
                        type="text" 
                        name="username" 
                        id="username" 
                        class="form-control" 
                        required
                    />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input 
                        type="password" 
                        name="password" 
                        id="password" 
                        class="form-control" 
                        required
                    />
                </div>
                <button class="btn btn-success w-100">
                    <b>Login</b>
                </button>
            </form>
        </div>
    </div>
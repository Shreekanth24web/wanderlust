<% layout('/layouts/boilerplate') %>

    <div class="row signup-page">
        <div class="col-6 offset-3">
            <form action="/signup" method="post" class="needs-validation signup-form" novalidate>
                <h3 class="signup-head">SignUp on Wanderlust</h3>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input 
                        type="text" 
                        name="username" 
                        id="username" 
                        class="form-control" 
                        required
                    />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input 
                        type="email" 
                        name="email" 
                        id="email" 
                        class="form-control" 
                        required
                    />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input 
                        type="password" 
                        name="password" 
                        id="password" 
                        class="form-control" 
                        required
                    />
                </div>
                <button class="btn btn-success w-100">
                    <b>SignUp</b>
                </button>
            </form>
        </div>
    </div>
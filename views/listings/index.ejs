<% layout("/layouts/boilerplate.ejs")%>

    <div class="main-content">

        <div id="filters" class="mt-4">
            <div class="row">
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-fire"></i>
                    </div>
                    <p>
                        <b>Trending</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-bed"></i>
                    </div>
                    <p>
                        <b>Rooms</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-mountain-city"></i>
                    </div>
                    <p>
                        <b>Iconic cities</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-mountain"></i>
                    </div>
                    <p>
                        <b>Mountains</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-brands fa-fort-awesome"></i>
                    </div>
                    <p>
                        <b>Castels</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-person-swimming"></i>
                    </div>
                    <p>
                        <b>Amazing Pools</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-campground"></i>
                    </div>
                    <p>
                        <b>Camping</b>
                    </p>
                </div>
            
            
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-cow"></i>
                    </div>
                    <p>
                        <b>Farms</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-water"></i>
                    </div>
                    <p>
                        <b>Lake</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-igloo"></i>
                    </div>
                    <p>
                        <b>Domes</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-volleyball"></i>
                    </div>
                    <p>
                        <b>play</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-ship"></i>
                    </div>
                    <p>
                        <b>Boats</b>
                    </p>
                </div>
                <div class="filter col">
                    <div>
                        <i class="fa-solid fa-tower-observation"></i>
                    </div>
                    <p>
                        <b>Towers</b>
                    </p>
                </div>
            </div>
        </div>

        <div class="tax-toggel ms-auto">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input " type="checkbox" role="switch" id="flexSwitchCheckDefault">
                <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
            </div>
        </div>


        <div class="row mt-3 row-cols-lg-3 row-cols-md-2 row-c">
            <% if (allListings.length===0 && typeof q !=='undefined' ) { %>
                <div class="alert alert-danger mt-4 w-75 offset-2 text-center">
                    <h5>No results found for "<%= q %>"</h5>
                </div>
                <% } else { %>

                    <% for(let listing of allListings){%>
                        <a href="/listings/<%=listing._id%>" class="listing-link">

                            <div class="card col listing-card">

                                <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_Image"
                                    style="height:20rem;">

                                <div class="card-img-overlay">
                                    <h5 class="card-title">
                                        <b>
                                            <%=listing.title%>
                                        </b>
                                    </h5>
                                    <p>
                                        <%=listing.description%>
                                    </p>
                                </div>

                                <div class="card-body">
                                    <p class="card-text">
                                        <b>
                                            <%=listing.title%>
                                        </b>
                                        <br>
                                        &#8377;<%=listing.price.toLocaleString('en-IN')%> / night
                                            <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                                    </p>
                                </div>

                            </div>
                        </a>

                        <%}%>
                            <% } %>
        </div>
    </div>